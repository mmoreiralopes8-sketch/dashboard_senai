                <div class="m"><span class="k">Situação</span><span class="v">Em dia</span></div>
              </div>
            </div>
            <button type="button" class="hist-toggle" aria-expanded="false"><span class="chev">▸</span> Ver histórico de pagamentos</button>
            <div class="hist-panel" hidden>
              <ul>
                <li><strong>Ago/2026</strong> — R$ 11.300 pago com 2 dias de atraso</li>
                <li><strong>Jul/2026</strong> — R$ 9.400 pago em dia</li>
                <li><strong>Jun/2026</strong> — R$ 14.600 pago em dia</li>
              </ul>
            </div>
          </div>
          <div class="credit-item">
            <div class="row-top">
              <div class="who">
                <strong>Auto Peças Rio</strong>
                <span>Cliente desde 2024</span>
              </div>
              <div class="credit-meta">
                <div class="m"><span class="k">Limite</span><span class="v mono">R$ 12.000</span></div>
                <div class="m"><span class="k">Risco</span><span class="v risk med">Médio</span></div>
                <div class="m"><span class="k">Situação</span><span class="v">Em dia</span></div>
              </div>
            </div>
            <button type="button" class="hist-toggle" aria-expanded="false"><span class="chev">▸</span> Ver histórico de pagamentos</button>
            <div class="hist-panel" hidden>
              <ul>
                <li><strong>Ago/2026</strong> — R$ 6.100 pago em dia</li>
                <li><strong>Jul/2026</strong> — primeira compra a prazo</li>
              </ul>
            </div>
          </div>
          <div class="credit-item">
            <div class="row-top">
              <div class="who">
                <strong>Farmácia Bem Estar</strong>
                <span>Cliente desde 2024 · 6 dias em atraso</span>
              </div>
              <div class="credit-meta">
                <div class="m"><span class="k">Limite</span><span class="v mono">R$ 8.000</span></div>
                <div class="m"><span class="k">Risco</span><span class="v risk med">Médio</span></div>
                <div class="m"><span class="k">Em aberto</span><span class="v mono">R$ 5.300</span></div>
              </div>
            </div>
            <p class="action">Ação: contato telefônico agendado para 24/09</p>
            <button type="button" class="hist-toggle" aria-expanded="false"><span class="chev">▸</span> Ver histórico de pagamentos</button>
            <div class="hist-panel" hidden>
              <ul>
                <li><strong>Ago/2026</strong> — R$ 4.900 pago com 9 dias de atraso</li>
                <li><strong>Jul/2026</strong> — R$ 5.200 pago com 4 dias de atraso</li>
                <li><strong>Jun/2026</strong> — R$ 3.700 pago em dia</li>
              </ul>
            </div>
          </div>
          <div class="credit-item">
            <div class="row-top">
              <div class="who">
                <strong>Padaria Estrela</strong>
                <span>Cliente desde 2022 · 12 dias em atraso</span>
              </div>
              <div class="credit-meta">
                <div class="m"><span class="k">Limite</span><span class="v mono">R$ 5.000</span></div>
                <div class="m"><span class="k">Risco</span><span class="v risk high">Alto</span></div>
                <div class="m"><span class="k">Em aberto</span><span class="v mono">R$ 3.450</span></div>
              </div>
            </div>
            <p class="action">Ação: 2ª notificação enviada · limite suspenso para novas compras</p>
            <button type="button" class="hist-toggle" aria-expanded="false"><span class="chev">▸</span> Ver histórico de pagamentos</button>
            <div class="hist-panel" hidden>
              <ul>
                <li><strong>Ago/2026</strong> — R$ 3.100 pago com 15 dias de atraso</li>
                <li><strong>Jul/2026</strong> — R$ 2.800 pago com 18 dias de atraso</li>
                <li><strong>Jun/2026</strong> — R$ 2.600 pago com 11 dias de atraso</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FLUXO DE CAIXA ===================== -->
    <section data-panel="fluxo-caixa" hidden>
      <div class="topbar">
        <div>
          <span class="sample-flag"><span class="dot"></span>Dados fictícios para exemplo</span>
          <h2>Fluxo de caixa</h2>
          <p class="sub">Entradas e saídas de dinheiro do caixa, semana a semana</p>
        </div>
        <div class="period-chip">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          Setembro de 2026
        </div>
      </div>

      <div class="kpi-row">
        <div class="kpi">
          <span class="label">Entradas no mês</span>
          <span class="value tabular">R$ 120.900</span>
          <span class="delta up">Vendas + recebimentos</span>
        </div>
        <div class="kpi">
          <span class="label">Saídas no mês</span>
          <span class="value tabular">R$ 103.800</span>
          <span class="delta down">Fornecedores + despesas</span>
        </div>
        <div class="kpi">
          <span class="label">Saldo do período</span>
          <span class="value tabular">R$ 17.100</span>
          <span class="delta up">Positivo</span>
        </div>
        <div class="kpi">
          <span class="label">Saldo acumulado</span>
          <span class="value tabular">R$ 128.450</span>
          <span class="delta flat">Em 30/09/2026</span>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <h3>Entradas e saídas por semana</h3>
            <p class="desc">Setembro/2026 — o saldo de cada semana aparece acima das barras</p>
          </div>
          <div class="legend">
            <span class="item"><span class="swatch" style="background:var(--data-in)"></span>Entradas</span>
            <span class="item"><span class="swatch" style="background:var(--data-out)"></span>Saídas</span>
          </div>
        </div>
        <div class="chart-scroll">
          <svg id="cashflow-full" class="chart-svg" viewBox="0 0 720 300" role="img" aria-label="Gráfico de barras comparando entradas e saídas de caixa nas quatro semanas de setembro, com o saldo de cada semana."></svg>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <h3>Detalhamento semanal</h3>
            <p class="desc">Mesmos dados do gráfico, em formato de tabela</p>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Semana</th>
                <th class="num">Entradas</th>
                <th class="num">Saídas</th>
                <th class="num">Saldo</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="entity">Semana 1 <span class="entity-sub">01 a 07/09</span></td>
                <td class="num mono">R$ 32.400</td>
                <td class="num mono">R$ 28.100</td>
                <td class="num mono" style="color:var(--good); font-weight:700">+ R$ 4.300</td>
              </tr>
              <tr>
                <td class="entity">Semana 2 <span class="entity-sub">08 a 14/09</span></td>
                <td class="num mono">R$ 27.800</td>
                <td class="num mono">R$ 35.600</td>
                <td class="num mono" style="color:var(--critical); font-weight:700">− R$ 7.800</td>
              </tr>
              <tr>
                <td class="entity">Semana 3 <span class="entity-sub">15 a 21/09</span></td>
                <td class="num mono">R$ 41.200</td>
                <td class="num mono">R$ 22.900</td>
                <td class="num mono" style="color:var(--good); font-weight:700">+ R$ 18.300</td>
              </tr>
              <tr>
                <td class="entity">Semana 4 <span class="entity-sub">22 a 30/09</span></td>
                <td class="num mono">R$ 19.500</td>
                <td class="num mono">R$ 17.200</td>
                <td class="num mono" style="color:var(--good); font-weight:700">+ R$ 2.300</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>
</div>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@500;600&display=swap">

<script>
(function () {
  "use strict";

  var prefersReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- KPI count-up ---------- */
  function parseKpiNumber(str) {
    var m = str.match(/^([^\d]*)([\d.,]+)(.*)$/);
    if (!m) return null;
    var prefix = m[1], numStr = m[2], suffix = m[3];
    var decimals = 0, normalized;
    if (numStr.indexOf(",") !== -1) {
      var parts = numStr.split(",");
      decimals = parts[1] ? parts[1].length : 0;
      normalized = parts[0].replace(/\./g, "") + (parts[1] ? "." + parts[1] : "");
    } else {
      normalized = numStr.replace(/\./g, "");
    }
    var value = parseFloat(normalized);
    if (isNaN(value)) return null;
    return { prefix: prefix, suffix: suffix, value: value, decimals: decimals };
  }

  function animateKpiValue(el) {
    var original = el.textContent;
    var parsed = parseKpiNumber(original);
    if (!parsed || prefersReducedMotion) return;
    var duration = 650, start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - p, 3);
      var current = parsed.value * eased;
      el.textContent = parsed.prefix + current.toLocaleString("pt-BR", { minimumFractionDigits: parsed.decimals, maximumFractionDigits: parsed.decimals }) + parsed.suffix;
      if (p < 1) requestAnimationFrame(step); else el.textContent = original;
    }
    requestAnimationFrame(step);
  }

  function animateKpisIn(panel) {
    if (!panel || prefersReducedMotion) return;
    var vals = Array.prototype.slice.call(panel.querySelectorAll(".kpi .value"));
    vals.forEach(function (v, i) {
      setTimeout(function () { animateKpiValue(v); }, i * 60);
    });
  }

  /* ---------- nav ---------- */
  var navButtons = Array.prototype.slice.call(document.querySelectorAll(".nav-btn"));
  var panels = Array.prototype.slice.call(document.querySelectorAll("section[data-panel]"));

  function showPanel(id) {
    panels.forEach(function (p) {
      var isTarget = p.getAttribute("data-panel") === id;
      p.hidden = !isTarget;
      p.classList.remove("panel-enter");
      if (isTarget) {
        void p.offsetWidth; /* restart animation */
        p.classList.add("panel-enter");
        animateKpisIn(p);
      }
    });
    navButtons.forEach(function (b) {
      if (b.getAttribute("data-target") === id) b.setAttribute("aria-current", "page");
      else b.removeAttribute("aria-current");
    });
    try { history.replaceState(null, "", "#" + id); } catch (e) {}
  }

  navButtons.forEach(function (b) {
    b.addEventListener("click", function () { showPanel(b.getAttribute("data-target")); });
  });

  var startId = (location.hash || "").replace("#", "");
  var validIds = panels.map(function (p) { return p.getAttribute("data-panel"); });
  if (validIds.indexOf(startId) !== -1) {
    showPanel(startId);
  } else {
    var current = panels.filter(function (p) { return !p.hidden; })[0];
    if (current) {
      current.classList.add("panel-enter");
      animateKpisIn(current);
    }
  }

  /* ---------- kpi / credit-item navigation ---------- */
  var goers = Array.prototype.slice.call(document.querySelectorAll("[data-goto]"));
  goers.forEach(function (el) {
    el.addEventListener("click", function () { showPanel(el.getAttribute("data-goto")); });
    el.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); showPanel(el.getAttribute("data-goto")); }
    });
  });

  /* ---------- table filters + search (combined) ---------- */
  function wireTable(tableId, filterAttr, filterGroupSelector, searchInputId) {
    var table = document.getElementById(tableId);
    if (!table) return;
    var dataRows = Array.prototype.slice.call(table.querySelectorAll("tbody tr.data-row"));
    var filterButtons = filterGroupSelector ? Array.prototype.slice.call(document.querySelectorAll(filterGroupSelector)) : [];
    var searchInput = searchInputId ? document.getElementById(searchInputId) : null;
    var activeStatus = "todas";

    function detailOf(row) {
      var next = row.nextElementSibling;
      return next && next.classList.contains("row-detail") ? next : null;
    }

    function applyFilters() {
      var term = searchInput ? searchInput.value.trim().toLowerCase() : "";
      dataRows.forEach(function (row) {
        var statusOk = activeStatus === "todas" || row.getAttribute("data-status") === activeStatus;
        var nameCell = row.querySelector(".entity");
        var name = nameCell ? nameCell.textContent.toLowerCase() : "";
        var termOk = term === "" || name.indexOf(term) !== -1;
        var show = statusOk && termOk;
        row.style.display = show ? "" : "none";
        var d = detailOf(row);
        if (d && !show) { d.hidden = true; row.setAttribute("aria-expanded", "false"); }
        if (d) d.style.display = show ? "" : "none";
      });
    }

    filterButtons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        filterButtons.forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
        btn.setAttribute("aria-pressed", "true");
        activeStatus = btn.getAttribute(filterAttr);
        applyFilters();
      });
    });

    if (searchInput) searchInput.addEventListener("input", applyFilters);

    /* row expand/collapse */
    dataRows.forEach(function (row) {
      row.addEventListener("click", function () {
        var d = detailOf(row);
        if (!d) return;
        var expanded = row.getAttribute("aria-expanded") === "true";
        d.hidden = expanded;
        row.setAttribute("aria-expanded", expanded ? "false" : "true");
      });
    });

    /* sortable columns */
    var ths = Array.prototype.slice.call(table.querySelectorAll("th.sortable"));
    ths.forEach(function (th, idx) {
      th.addEventListener("click", function () {
        var type = th.getAttribute("data-sort");
        var colIndex = Array.prototype.indexOf.call(th.parentElement.children, th);
        var dir = th.getAttribute("data-dir") === "asc" ? "desc" : "asc";
        ths.forEach(function (t) { t.removeAttribute("data-dir"); });
        th.setAttribute("data-dir", dir);

        var tbody = table.querySelector("tbody");
        var pairs = dataRows.map(function (row) {
          return { row: row, detail: detailOf(row) };
        });
        pairs.sort(function (a, b) {
          var av = type === "num" ? parseFloat(a.row.getAttribute("data-value")) : a.row.getAttribute("data-date");
          var bv = type === "num" ? parseFloat(b.row.getAttribute("data-value")) : b.row.getAttribute("data-date");
          if (av < bv) return dir === "asc" ? -1 : 1;
          if (av > bv) return dir === "asc" ? 1 : -1;
          return 0;
        });
        pairs.forEach(function (p) {
          tbody.appendChild(p.row);
          if (p.detail) tbody.appendChild(p.detail);
        });
      });
    });

    applyFilters();
  }
  wireTable("table-pagar", "data-filter-pay", "[data-filter-pay]", "search-pagar");
  wireTable("table-receber", "data-filter-rec", "[data-filter-rec]", "search-receber");

  /* ---------- credit history toggles ---------- */
  var histToggles = Array.prototype.slice.call(document.querySelectorAll(".hist-toggle"));
  histToggles.forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var panel = btn.nextElementSibling;
      var expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", expanded ? "false" : "true");
      if (panel) panel.hidden = expanded;
    });
  });

  /* ---------- weekly cash flow chart ---------- */
  var weeks = [
    { label: "Sem. 1", sub: "01–07/09", in: 32400, out: 28100 },
    { label: "Sem. 2", sub: "08–14/09", in: 27800, out: 35600 },
    { label: "Sem. 3", sub: "15–21/09", in: 41200, out: 22900 },
    { label: "Sem. 4", sub: "22–30/09", in: 19500, out: 17200 }
  ];

  function fmtBRL(n) {
    var neg = n < 0;
    var s = Math.round(Math.abs(n)).toString();
    var withSep = s.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    return (neg ? "−R$ " : "R$ ") + withSep;
  }

  function fmtShort(n) {
    return (n / 1000).toLocaleString("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "k";
  }

  function drawChart(svgId, w, h, showSub) {
    var svg = document.getElementById(svgId);
    if (!svg) return;
    var style = getComputedStyle(document.documentElement);
    var cIn = style.getPropertyValue("--data-in").trim();
    var cOut = style.getPropertyValue("--data-out").trim();
    var cGood = style.getPropertyValue("--good").trim();
    var cCrit = style.getPropertyValue("--critical").trim();
    var cGoodSoft = style.getPropertyValue("--good-soft").trim();
    var cCritSoft = style.getPropertyValue("--critical-soft").trim();
    var cSurface = style.getPropertyValue("--surface").trim();
    var cGrid = "color-mix(in srgb, currentColor 12%, transparent)";
    var cAxis = "color-mix(in srgb, currentColor 30%, transparent)";
    var cMuted = "currentColor";

    var padL = 8, padR = 8, padT = 54, padB = 34;
    var plotW = w - padL - padR;
    var plotH = h - padT - padB;
    var maxVal = Math.max.apply(null, weeks.map(function (d) { return Math.max(d.in, d.out); }));
    var niceMax = Math.ceil(maxVal / 10000) * 10000;

    var groupW = plotW / weeks.length;
    var barGap = groupW * 0.14;
    var barW = (groupW - barGap * 3) / 2;

    var svgns = "http://www.w3.org/2000/svg";
    function el(tag, attrs) {
      var e = document.createElementNS(svgns, tag);
      for (var k in attrs) e.setAttribute(k, attrs[k]);
      return e;
    }
    function titled(node, text) {
      var t = document.createElementNS(svgns, "title");
      t.textContent = text;
      node.appendChild(t);
      return node;
    }

    while (svg.firstChild) svg.removeChild(svg.firstChild);
    svg.setAttribute("viewBox", "0 0 " + w + " " + h);
    svg.style.color = "var(--text-faint)";

    /* gridlines: 0, 1/2, max */
    [0, 0.5, 1].forEach(function (t) {
      var y = padT + plotH * (1 - t);
      svg.appendChild(el("line", { x1: padL, x2: w - padR, y1: y, y2: y, stroke: cGrid, "stroke-width": 1 }));
      var label = svg.ownerDocument.createElementNS(svgns, "text");
      label.setAttribute("x", padL);
      label.setAttribute("y", y - 4);
      label.setAttribute("class", "bar-tip");
      label.setAttribute("fill", cMuted);
      label.textContent = t === 0 ? "R$ 0" : fmtBRL(niceMax * t);
      svg.appendChild(label);
    });

    var growers = [];

    weeks.forEach(function (d, i) {
      var gx = padL + i * groupW;
      var xIn = gx + barGap;
      var xOut = xIn + barW + barGap;
      var hIn = (d.in / niceMax) * plotH;
      var hOut = (d.out / niceMax) * plotH;
      var yIn = padT + plotH - hIn;
      var yOut = padT + plotH - hOut;
      var baseline = padT + plotH;

      var barIn = el("rect", { x: xIn, y: baseline, width: barW, height: 0.0001, rx: 4, fill: cIn, class: "bar-shape", tabindex: "0" });
      var barOut = el("rect", { x: xOut, y: baseline, width: barW, height: 0.0001, rx: 4, fill: cOut, class: "bar-shape", tabindex: "0" });
      titled(barIn, "Entradas · " + d.label + ": " + fmtBRL(d.in));
      titled(barOut, "Saídas · " + d.label + ": " + fmtBRL(d.out));
      svg.appendChild(barIn);
      svg.appendChild(barOut);
      growers.push({ el: barIn, y0: baseline, y1: yIn, h0: 0.0001, h1: Math.max(hIn, 1) });
      growers.push({ el: barOut, y0: baseline, y1: yOut, h0: 0.0001, h1: Math.max(hOut, 1) });

      var valIn = el("text", { x: xIn + barW / 2, y: yIn - 10, "text-anchor": "middle", fill: cIn, opacity: 0 });
      valIn.setAttribute("class", "bar-tip strong");
      valIn.textContent = fmtShort(d.in);
      svg.appendChild(valIn);

      var valOut = el("text", { x: xOut + barW / 2, y: yOut - 10, "text-anchor": "middle", fill: cOut, opacity: 0 });
      valOut.setAttribute("class", "bar-tip strong");
      valOut.textContent = fmtShort(d.out);
      svg.appendChild(valOut);
      growers.push({ el: valIn, fadeOnly: true });
      growers.push({ el: valOut, fadeOnly: true });

      var saldo = d.in - d.out;
      var isPos = saldo >= 0;
      var badgeText = (isPos ? "+ " : "− ") + fmtBRL(Math.abs(saldo));
      var badgeW = Math.max(56, badgeText.length * 6.6 + 16);
      var badgeH = 20;
      var topLabelY = Math.min(yIn, yOut) - 10;
      var badgeCY = Math.max(topLabelY - 22, padT - 20);

      var badge = el("rect", { x: gx + groupW / 2 - badgeW / 2, y: badgeCY - badgeH / 2, width: badgeW, height: badgeH, rx: 10, fill: isPos ? cGoodSoft : cCritSoft, opacity: 0 });
      var badgeLabel = el("text", { x: gx + groupW / 2, y: badgeCY + 4, "text-anchor": "middle", fill: isPos ? cGood : cCrit, opacity: 0 });
      badgeLabel.setAttribute("class", "bar-tip strong");
      badgeLabel.textContent = badgeText;
      svg.appendChild(badge);
      svg.appendChild(badgeLabel);
      growers.push({ el: badge, fadeOnly: true });
      growers.push({ el: badgeLabel, fadeOnly: true });

      var axisLabel = el("text", { x: gx + groupW / 2, y: h - padB + 18, "text-anchor": "middle", fill: cMuted });
      axisLabel.setAttribute("class", "bar-tip");
      axisLabel.textContent = showSub ? d.label + "  ·  " + d.sub : d.label;
      svg.appendChild(axisLabel);
    });

    svg.appendChild(el("line", { x1: padL, x2: w - padR, y1: padT + plotH, y2: padT + plotH, stroke: cAxis, "stroke-width": 1 }));

    /* grow-in animation */
    if (prefersReducedMotion) {
      growers.forEach(function (g) {
        if (g.fadeOnly) { g.el.setAttribute("opacity", 1); return; }
        g.el.setAttribute("height", g.h1);
        g.el.setAttribute("y", g.y1);
      });
    } else {
      var start = null;
      var duration = 550;
      var ease = function (t) { return 1 - Math.pow(1 - t, 3); };
      var frame = function (ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / duration, 1);
        var e = ease(p);
        growers.forEach(function (g) {
          if (g.fadeOnly) { g.el.setAttribute("opacity", e); return; }
          g.el.setAttribute("height", g.h0 + (g.h1 - g.h0) * e);
          g.el.setAttribute("y", g.y0 + (g.y1 - g.y0) * e);
        });
        if (p < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }

  function renderCharts() {
    drawChart("cashflow-mini", 560, 220, false);
    drawChart("cashflow-full", 720, 300, true);
  }

  renderCharts();
  window.addEventListener("resize", renderCharts);
  if (window.matchMedia) {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", renderCharts);
  }
})();
</script>
