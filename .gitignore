<title>Painel Vértice</title>
<meta name="description" content="Sistema fictício de administração financeira, com dados de exemplo para contas a pagar, a receber, crédito e cobrança, e fluxo de caixa.">
<style>
  :root {
    color-scheme: light;
    --bg: #F3F5F3;
    --surface: #FFFFFF;
    --surface-alt: #EBF0ED;
    --border: rgba(15, 26, 21, 0.10);
    --border-strong: rgba(15, 26, 21, 0.16);
    --text: #101915;
    --text-muted: #566159;
    --text-faint: #8A948C;
    --accent: #0F6E5C;
    --accent-strong: #0B5245;
    --accent-soft: #E1F0EA;
    --data-in: #1BAF7A;
    --data-in-soft: #E1F6EC;
    --data-out: #D9622E;
    --data-out-soft: #FBEBE1;
    --good: #0C7A2E;
    --good-soft: #E4F5E8;
    --warning: #9C6B05;
    --warning-soft: #FBF1DA;
    --critical: #B23324;
    --critical-soft: #FBEAE6;
    --shadow: 0 1px 2px rgba(15,26,21,0.04), 0 8px 24px -12px rgba(15,26,21,0.18);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0C1210;
      --surface: #141C19;
      --surface-alt: #1A2320;
      --border: rgba(255,255,255,0.09);
      --border-strong: rgba(255,255,255,0.16);
      --text: #E9F0EC;
      --text-muted: #9FAEA6;
      --text-faint: #6D7A73;
      --accent: #4ED1AD;
      --accent-strong: #6EDFC0;
      --accent-soft: #16332C;
      --data-in: #2FBE87;
      --data-in-soft: #163A2C;
      --data-out: #E58254;
      --data-out-soft: #3A2417;
      --good: #43C97A;
      --good-soft: #143A24;
      --warning: #E4B450;
      --warning-soft: #3A2E12;
      --critical: #E5776A;
      --critical-soft: #3A1D18;
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0C1210;
    --surface: #141C19;
    --surface-alt: #1A2320;
    --border: rgba(255,255,255,0.09);
    --border-strong: rgba(255,255,255,0.16);
    --text: #E9F0EC;
    --text-muted: #9FAEA6;
    --text-faint: #6D7A73;
    --accent: #4ED1AD;
    --accent-strong: #6EDFC0;
    --accent-soft: #16332C;
    --data-in: #2FBE87;
    --data-in-soft: #163A2C;
    --data-out: #E58254;
    --data-out-soft: #3A2417;
    --good: #43C97A;
    --good-soft: #143A24;
    --warning: #E4B450;
    --warning-soft: #3A2E12;
    --critical: #E5776A;
    --critical-soft: #3A1D18;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Source Sans 3', 'Segoe UI', Arial, sans-serif;
    padding: 0;
    min-height: 100%;
  }
  h1, h2, h3, .num-display {
    font-family: 'Manrope', 'Segoe UI', Arial, sans-serif;
    text-wrap: balance;
    margin: 0;
  }
  .tabular { font-variant-numeric: tabular-nums; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, Consolas, monospace; font-variant-numeric: tabular-nums; }

  a { color: var(--accent-strong); }

  /* ---------- shell ---------- */
  .shell {
    display: flex;
    min-height: 100vh;
  }
  .sidebar {
    width: 248px;
    flex: none;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 28px 16px;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 10px 24px;
  }
  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(155deg, var(--accent) 0%, var(--accent-strong) 100%);
    flex: none;
  }
  .brand-text h1 { font-size: 17px; font-weight: 800; letter-spacing: -0.2px; }
  .brand-text p { margin: 2px 0 0; font-size: 12px; color: var(--text-faint); }

  .nav-group-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 16px 12px 6px;
  }
  .nav-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    text-align: left;
    padding: 10px 12px;
    border-radius: 10px;
    cursor: pointer;
  }
  .nav-btn:hover { background: var(--surface-alt); color: var(--text); }
  .nav-btn[aria-current="page"] { background: var(--accent-soft); color: var(--accent-strong); }
  .nav-btn:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nav-ico { width: 18px; height: 18px; flex: none; stroke: currentColor; }

  .sidebar-foot {
    margin-top: auto;
    padding: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar-foot .avatar-row { display: flex; align-items: center; gap: 10px; }
  .avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--accent-soft);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: var(--accent-strong);
    flex: none;
  }
  .avatar svg { width: 16px; height: 16px; }
  .sidebar-foot .who p { margin: 0; font-size: 13px; font-weight: 700; }
  .sidebar-foot .who span { font-size: 11.5px; color: var(--text-faint); }
  .team-names {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--text-faint);
  }

  .main {
    flex: 1;
    min-width: 0;
    padding: 28px 36px 64px;
  }
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .topbar h2 { font-size: 24px; font-weight: 800; letter-spacing: -0.3px; }
  .topbar .sub { margin: 4px 0 0; font-size: 13.5px; color: var(--text-faint); }
  .period-chip {
    display: flex; align-items: center; gap: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 13px; font-weight: 600; color: var(--text-muted);
  }
  .sample-flag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11.5px; font-weight: 700;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 4px 10px 4px 8px;
    margin-bottom: 6px;
  }
  .sample-flag .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  section[data-panel] { display: flex; flex-direction: column; gap: 24px; }
  section[data-panel].panel-enter { animation: panelIn 0.4s ease both; }
  @keyframes panelIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    section[data-panel].panel-enter { animation: none; }
  }

  /* ---------- kpi cards ---------- */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kpi .label { font-size: 13px; color: var(--text-muted); font-weight: 600; }
  .kpi .value { font-size: 28px; font-weight: 800; letter-spacing: -0.4px; }
  .kpi .delta { font-size: 12.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; width: fit-content; padding: 3px 8px; border-radius: 999px; }
  .delta.up { color: var(--good); background: var(--good-soft); }
  .delta.down { color: var(--critical); background: var(--critical-soft); }
  .delta.flat { color: var(--text-muted); background: var(--surface-alt); }
  .kpi.clickable { cursor: pointer; transition: border-color 0.12s ease, transform 0.12s ease; }
  .kpi.clickable:hover { border-color: var(--accent); transform: translateY(-1px); }
  .kpi.clickable .goto { font-size: 11.5px; font-weight: 700; color: var(--accent-strong); display: inline-flex; align-items: center; gap: 3px; }
  .kpi.clickable .goto svg { width: 11px; height: 11px; }

  /* ---------- generic panel/card ---------- */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 22px 22px 24px;
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .card-head h3 { font-size: 16px; font-weight: 800; }
  .card-head .desc { margin: 3px 0 0; font-size: 13px; color: var(--text-faint); max-width: 46ch; }

  .grid-2 { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; align-items: start; }

  /* ---------- filter chips ---------- */
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters button {
    font: inherit; font-size: 12.5px; font-weight: 700;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 6px 13px;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] { background: var(--text); color: var(--surface); border-color: var(--text); }

  .search-box {
    display: flex; align-items: center; gap: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    border-radius: 999px;
    padding: 7px 14px 7px 12px;
    min-width: 220px;
  }
  .search-box svg { flex: none; color: var(--text-faint); }
  .search-box input {
    border: none; outline: none; background: transparent;
    font: inherit; font-size: 13px; color: var(--text);
    width: 100%;
  }
  .search-box input::placeholder { color: var(--text-faint); }
  .toolbar-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; justify-content: space-between; width: 100%; }

  /* ---------- table ---------- */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  thead th {
    text-align: left;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    padding: 0 12px 10px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--text); }
  th.sortable .arrow { display: inline-block; margin-left: 4px; opacity: 0.35; font-size: 10px; }
  th.sortable[data-dir="asc"] .arrow, th.sortable[data-dir="desc"] .arrow { opacity: 1; color: var(--accent-strong); }
  th.sortable[data-dir="asc"] .arrow::before { content: "▲"; }
  th.sortable[data-dir="desc"] .arrow::before { content: "▼"; }
  th.sortable:not([data-dir]) .arrow::before { content: "▲"; }
  tbody td {
    padding: 12px 12px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    vertical-align: middle;
  }
  tbody tr.data-row { cursor: pointer; }
  tbody tr.data-row:last-of-type td { border-bottom: none; }
  tbody tr:hover td { background: var(--surface-alt); }
  tbody tr.row-detail td { background: var(--surface-alt); border-bottom: 1px solid var(--border); padding: 14px 12px 16px 34px; }
  tbody tr.row-detail:hover td { background: var(--surface-alt); }
  tbody tr.row-detail[hidden] { display: none; }
  .detail-grid { display: flex; gap: 28px; flex-wrap: wrap; font-size: 12.5px; color: var(--text-muted); }
  .detail-grid strong { color: var(--text); font-weight: 700; }
  td.num, th.num { text-align: right; }
  .entity { font-weight: 700; }
  .entity-sub { display: block; font-size: 12px; font-weight: 500; color: var(--text-faint); margin-top: 1px; }
  .chev {
    display: inline-block; width: 8px; margin-right: 8px;
    color: var(--text-faint);
    transition: transform 0.15s ease;
    transform: rotate(0deg);
  }
  tr.data-row[aria-expanded="true"] .chev { transform: rotate(90deg); color: var(--accent-strong); }

  .status {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .status.good { color: var(--good); background: var(--good-soft); }
  .status.good .dot { background: var(--good); }
  .status.warn { color: var(--warning); background: var(--warning-soft); }
  .status.warn .dot { background: var(--warning); }
  .status.bad { color: var(--critical); background: var(--critical-soft); }
  .status.bad .dot { background: var(--critical); }

  .risk { font-size: 12px; font-weight: 700; }
  .risk.low { color: var(--good); }
  .risk.med { color: var(--warning); }
  .risk.high { color: var(--critical); }

  /* ---------- legend ---------- */
  .legend { display: flex; gap: 18px; flex-wrap: wrap; font-size: 12.5px; color: var(--text-muted); font-weight: 600; }
  .legend .item { display: inline-flex; align-items: center; gap: 7px; }
  .legend .swatch { width: 10px; height: 10px; border-radius: 3px; }

  /* ---------- chart ---------- */
  .chart-scroll { overflow-x: auto; }
  .chart-svg { min-width: 560px; }
  .bar-tip { font-size: 11.5px; fill: var(--text-muted); font-family: 'Source Sans 3', sans-serif; }
  .bar-tip.strong { font-weight: 700; fill: var(--text); }
  .bar-shape { cursor: pointer; transition: filter 0.12s ease, opacity 0.12s ease; }
  .bar-shape:hover, .bar-shape:focus-visible { filter: brightness(1.15); outline: none; }

  /* ---------- credit list ---------- */
  .credit-list { display: flex; flex-direction: column; gap: 10px; }
  .credit-item {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    flex-wrap: wrap;
  }
  .credit-item[data-goto] { cursor: pointer; transition: border-color 0.12s ease; }
  .credit-item[data-goto]:hover { border-color: var(--accent); background: var(--surface-alt); }
  .credit-item .who { display: flex; flex-direction: column; gap: 2px; min-width: 180px; }
  .credit-item .who strong { font-size: 14px; }
  .credit-item .who span { font-size: 12px; color: var(--text-faint); }
  .credit-meta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .credit-meta .m { display: flex; flex-direction: column; gap: 2px; min-width: 96px; }
  .credit-meta .m .k { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-faint); font-weight: 700; }
  .credit-meta .m .v { font-size: 13.5px; font-weight: 700; }
  .credit-item .action { font-size: 12.5px; color: var(--text-muted); max-width: 220px; }
  .credit-item { flex-direction: column; align-items: stretch; }
  .credit-item .row-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .hist-toggle {
    align-self: flex-start;
    font: inherit; font-size: 12px; font-weight: 700;
    color: var(--accent-strong);
    background: none; border: none; padding: 2px 0; margin-top: 2px;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .hist-toggle .chev { transition: transform 0.15s ease; }
  .hist-toggle[aria-expanded="true"] .chev { transform: rotate(90deg); }
  .hist-panel { margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border-strong); }
  .hist-panel[hidden] { display: none; }
  .hist-panel ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 5px; }
  .hist-panel li { font-size: 12.5px; color: var(--text-muted); }
  .hist-panel li strong { color: var(--text); }

  .foot-note { font-size: 12px; color: var(--text-faint); padding-top: 4px; }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .shell { flex-direction: column; }
    .sidebar {
      width: 100%;
      height: auto;
      position: static;
      flex-direction: row;
      align-items: center;
      overflow-x: auto;
      padding: 14px 16px;
      gap: 10px;
    }
    .brand { padding: 0; }
    .nav-group-label { display: none; }
    .sidebar nav { display: flex; gap: 6px; }
    .nav-btn { white-space: nowrap; }
    .sidebar-foot { display: none; }
    .main { padding: 20px 16px 48px; }
    .kpi-row { grid-template-columns: 1fr 1fr; }
    .grid-2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>

<div class="shell">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"></div>
      <div class="brand-text">
        <h1>Vértice</h1>
        <p>Administração financeira</p>
      </div>
    </div>
    <p class="nav-group-label">Painel</p>
    <nav>
      <button class="nav-btn" type="button" data-target="visao-geral" aria-current="page">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/><rect x="3" y="14" width="8" height="7" rx="1.5"/></svg>
        Visão geral
      </button>
      <button class="nav-btn" type="button" data-target="contas-pagar">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 8.5 12 3l9 5.5"/><rect x="4.5" y="10" width="15" height="10.5" rx="1.5"/><path d="M9 15.2h6"/></svg>
        Contas a pagar
      </button>
      <button class="nav-btn" type="button" data-target="contas-receber">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9.5h18"/><path d="M7 14.2h4"/></svg>
        Contas a receber
      </button>
      <button class="nav-btn" type="button" data-target="credito-cobranca">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 3 4.5 6v5.2c0 5 3.2 8.3 7.5 9.8 4.3-1.5 7.5-4.8 7.5-9.8V6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
        Crédito e cobrança
      </button>
      <button class="nav-btn" type="button" data-target="fluxo-caixa">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 18 9 11l4 4 8-9"/><path d="M14.5 6H21v6.5"/></svg>
        Fluxo de caixa
      </button>
    </nav>
    <div class="sidebar-foot">
      <div class="avatar-row">
        <div class="avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20"/><circle cx="9.5" cy="8" r="3"/><path d="M15.5 14.2A3 3 0 0 1 18 17v.5"/><path d="M14.3 5.2a3 3 0 0 1 0 5.6"/></svg>
        </div>
        <div class="who">
          <p>Equipe do projeto</p>
          <span>Administração financeira</span>
        </div>
      </div>
      <p class="team-names">Guilherme Henrique, Arthur Sales, Matheus Moreira, Matheus Gabriel, João e Lorran</p>
    </div>
  </aside>

  <main class="main">

    <!-- ===================== VISÃO GERAL ===================== -->
    <section data-panel="visao-geral">
      <div class="topbar">
        <div>
          <span class="sample-flag"><span class="dot"></span>Dados fictícios para exemplo</span>
          <h2>Visão geral</h2>
          <p class="sub">Vértice Distribuidora Ltda. — posição financeira em Setembro/2026</p>
        </div>
        <div class="period-chip">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          Setembro de 2026
        </div>
      </div>

      <div class="kpi-row">
        <div class="kpi clickable" data-goto="fluxo-caixa" role="button" tabindex="0">
          <span class="label">Saldo em caixa</span>
          <span class="value tabular">R$ 128.450</span>
          <span class="delta up">▲ 6,8% vs. agosto</span>
          <span class="goto">Ver fluxo de caixa <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></span>
        </div>
        <div class="kpi clickable" data-goto="contas-receber" role="button" tabindex="0">
